# ==============================================================================
# SISTEMA_VENTAS_LO - CONFIGURACIÓN DE VARIABLES DE ENTORNO
# Copia este archivo como '.env' para desarrollo local y staging.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLANETA Y MODO DE ENTORNO (Development | Staging | Production)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. BASE DE DATOS POSTGRESQL (Aislada en Staging / Ficticia)
# ------------------------------------------------------------------------------
POSTGRES_DB=sistema_ventas_lo_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password_123
POSTGRES_PORT=5432
POSTGRES_HOST=postgres-db

# Cadena de conexión para Backend .NET
CONNECTION_STRING=Host=postgres-db;Port=5432;Database=sistema_ventas_lo_dev;Username=postgres;Password=postgres_dev_password_123;

# ------------------------------------------------------------------------------
# 3. BACKEND API (.NET 8 Clean Architecture)
# ------------------------------------------------------------------------------
API_PORT=5000
API_URL=http://localhost:5000

# Seguridad JWT
JWT_SECRET_KEY=clave_secreta_super_segura_para_desarrollo_staging_minimo_32_caracteres_lo_2026
JWT_ISSUER=SistemaVentasLO_AuthServer
JWT_AUDIENCE=SistemaVentasLO_Clients
JWT_EXPIRATION_MINUTES=480

# ------------------------------------------------------------------------------
# 4. FRONTEND WEB ADMIN (React + Vite)
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 5. HERRAMIENTAS DEV (pgAdmin 4)
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@sistemaventaslo.com
PGADMIN_DEFAULT_PASSWORD=admin_dev_password
PGADMIN_PORT=5050
